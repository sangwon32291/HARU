# HARU 환경 변수 예시
# 이 파일을 복사해 .env 로 저장한 뒤 값을 채우십시오.
#   cp .env.example .env
# .env 는 .gitignore 에 포함되어 있으므로 Git 에 올라가지 않습니다.

# 데이터 소스: mock | supabase
# mock     : 외부 설정 없이 브라우저 내 샘플 데이터로 동작 (기본값)
# supabase : 실제 Supabase 프로젝트에 연결 (아래 두 값 필수)
VITE_DATA_SOURCE=mock

# Supabase 프로젝트 설정 (VITE_DATA_SOURCE=supabase 일 때만 필요)
# Supabase 대시보드 > Project Settings > API 에서 확인
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 주의: service_role 키는 절대 이 파일이나 프론트엔드 코드에 넣지 마십시오.
#       브라우저 번들에 포함되어 DB 전체가 노출됩니다.

# 개발용 도구 노출 여부 — 배포 시 반드시 false
VITE_ENABLE_DEV_TOOLS=true
